#!/bin/bash
# Submit from the project dir:  mkdir -p logs && qsub "HPC guidelines/generate.pbs"
#
# Fill in the project ID and check the queue name against the NUS HPC docs / `qstat -Q`.
#PBS -N sd_generate
#PBS -P <your_project_id>
#PBS -q auto
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o logs/

set -euo pipefail
cd "$PBS_O_WORKDIR"

module load python 2>/dev/null || true
source .venv/bin/activate

# Must match HF_HOME in setup_env.sh. Offline so the job uses the cached models.
export HF_HOME="${HF_HOME:-$HOME/scratch/hf_cache}"
export HF_HUB_OFFLINE=1

nvidia-smi
python -c "import torch; assert torch.cuda.is_available(), 'No GPU visible to PyTorch'; print('GPU:', torch.cuda.get_device_name(0))"

python generate.py
