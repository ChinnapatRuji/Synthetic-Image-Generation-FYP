{
    "paths": {
        "dataset_dir": "prepared_dataset",
        "output_dir": "output_model",
        "generated_dir": "generated",
        "kohya_dir": "kohya_ss"
    },
    "model": {
        "base": "SG161222/Realistic_Vision_V5.1_noVAE",
        "vae": "stabilityai/sd-vae-ft-mse",
        "clip_skip": 1
    },
    "dataset": {
        "trigger": "sldrjnt",
        "domain": "close-up macro photo of a vertical metal electrode solder joint, dark blurry background",
        "max_size": 1024,
        "min_size": 256,
        "max_repeats": 10,
        "classes": [
            {
                "name": "OK",
                "path": "raw/OK",
                "description": "aligned vertically stacked electrodes, top and bottom electrode on the same vertical center axis, centered solder joint"
            },
            {
                "name": "NG-Misalign",
                "path": "raw/NG-Misalign",
                "description": "misaligned vertically stacked electrodes, top and bottom electrode on different vertical center axes, visible lateral offset at solder joint"
            },
            {
                "name": "NG-Single",
                "path": "raw/NG-Single",
                "description": "vertically stacked electrodes but only one electrode present, missing opposing electrode at the solder joint"
            },
            {
                "name": "NG-No solder",
                "path": "raw/NG-No solder",
                "description": "vertically stacked electrodes with no solder, missing solder material between top and bottom electrode"
            },
            {
                "name": "NG-Not enough solder",
                "path": "raw/NG-Not enough solder",
                "description": "vertically stacked electrodes with insufficient solder, too little solder material at the joint between top and bottom electrode"
            }
        ]
    },
    "lora": {
        "network_dim": 32,
        "network_alpha": 16,
        "train_text_encoder": true,
        "train_conv_layers": false,
        "conv_dim": 16,
        "conv_alpha": 8
    },
    "training": {
        "output_name": "sd15_lora",
        "epochs": 60,
        "max_train_steps": 0,
        "batch_size": 1,
        "grad_accum": 2,
        "resolution": 512,
        "save_every_n_epochs": 5,
        "seed": 42,
        "flip_aug": false,
        "shuffle_caption": false,
        "keep_tokens": 1,
        "optimizer": {
            "name": "AdamW8bit",
            "unet_lr": 5e-05,
            "text_encoder_lr": 5e-06,
            "lr_scheduler": "cosine",
            "lr_warmup_ratio": 0.05,
            "lr_cycles": 1,
            "min_snr_gamma": 5,
            "noise_offset": 0.05,
            "max_grad_norm": 1,
            "prodigy": {
                "weight_decay": 0.01,
                "decouple": true,
                "d_coef": 2,
                "use_bias_correction": true,
                "safeguard_warmup": true,
                "betas": [
                    0.9,
                    0.99
                ]
            }
        },
        "bucketing": {
            "enabled": false,
            "min_size": 256,
            "max_size": 512,
            "step": 64
        },
        "memory": {
            "mixed_precision": "fp16",
            "attention": "sdpa",
            "gradient_checkpointing": true,
            "cache_latents": true,
            "cache_to_disk": true,
            "full_fp16": false
        }
    },
    "generation_defaults": {
        "txt2img": {
            "mode": "txt2img",
            "images_per_class": 5,
            "only_classes": [],
            "lora_scale": 0.85,
            "width": 512,
            "height": 512,
            "steps": 35,
            "cfg": 6.5,
            "sampler": "dpmpp_2m_karras",
            "negative_prompt": "text, watermark, cartoon, illustration, painting, severe image artifacts",
            "seed": 1000,
            "batch_size": 1,
            "prompt_variations": [
                "subtle variation in lighting",
                "slightly different camera exposure",
                "minor background illumination variation",
                "subtle surface appearance variation"
            ],
            "execution": {
                "device": "auto",
                "precision": "auto",
                "memory_strategy": "auto"
            }
        },
        "img2img": {
            "mode": "img2img",
            "images_per_class": 5,
            "only_classes": [],
            "lora_scale": 0.85,
            "width": 512,
            "height": 512,
            "steps": 35,
            "cfg": 6.5,
            "sampler": "dpmpp_2m_karras",
            "negative_prompt": "text, watermark, cartoon, illustration, painting, severe image artifacts",
            "seed": 1000,
            "batch_size": 1,
            "prompt_variations": [
                "subtle variation in lighting",
                "slightly different camera exposure",
                "minor background illumination variation",
                "subtle surface appearance variation"
            ],
            "execution": {
                "device": "auto",
                "precision": "auto",
                "memory_strategy": "auto"
            },
            "strength": 0.35
        }
    }
}