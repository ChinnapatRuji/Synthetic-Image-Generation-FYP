{
    "paths": {
        "dataset_dir": "prepared_dataset",
        "output_dir": "output_model",
        "generated_dir": "generated",
        "kohya_dir": "kohya_ss"
    },
    "model": {
        "architecture": "sd3",
        "base": "stabilityai/stable-diffusion-3.5-medium",
        "vae": "",
        "clip_skip": 1
    },
    "dataset": {
        "trigger": "sldrjnt",
        "domain": "close-up macro photo of a vertical metal electrode solder joint, dark blurry background",
        "max_size": 1024,
        "min_size": 256,
        "max_repeats": 10
    },
    "lora": {
        "network_dim": 32,
        "network_alpha": 16,
        "train_text_encoder": false,
        "train_conv_layers": false,
        "conv_dim": 16,
        "conv_alpha": 8
    },
    "training": {
        "output_name": "sd35m_lora",
        "epochs": 50,
        "max_train_steps": 0,
        "batch_size": 1,
        "grad_accum": 2,
        "resolution": 512,
        "save_every_n_epochs": 10,
        "seed": 42,
        "flip_aug": false,
        "shuffle_caption": false,
        "keep_tokens": 1,
        "optimizer": {
            "name": "AdamW8bit",
            "unet_lr": 5e-05,
            "text_encoder_lr": 1e-05,
            "lr_scheduler": "cosine",
            "lr_warmup_ratio": 0.05,
            "lr_cycles": 1,
            "min_snr_gamma": 0,
            "noise_offset": 0,
            "max_grad_norm": 1,
            "prodigy": {
                "weight_decay": 0.01,
                "decouple": true,
                "d_coef": 2,
                "use_bias_correction": true,
                "safeguard_warmup": true,
                "betas": [
                    0.9,
                    0.99
                ]
            }
        },
        "bucketing": {
            "enabled": false,
            "min_size": 256,
            "max_size": 512,
            "step": 64
        },
        "memory": {
            "mixed_precision": "bf16",
            "attention": "sdpa",
            "gradient_checkpointing": true,
            "cache_latents": true,
            "cache_to_disk": true,
            "full_fp16": false
        }
    },
    "generation_defaults": {
        "txt2img": {
            "mode": "txt2img",
            "images_per_class": 5,
            "only_classes": [],
            "lora_scale": 0.95,
            "width": 512,
            "height": 512,
            "steps": 40,
            "cfg": 4.5,
            "sampler": "default",
            "negative_prompt": "text, watermark, cartoon, illustration, painting, severe image artifacts",
            "seed": 1000,
            "batch_size": 1,
            "prompt_variations": [
                "subtle variation in lighting",
                "slightly different camera exposure",
                "minor background illumination variation",
                "subtle surface appearance variation"
            ],
            "execution": {
                "device": "auto",
                "precision": "auto",
                "memory_strategy": "auto"
            }
        },
        "img2img": {
            "mode": "img2img",
            "images_per_class": 5,
            "only_classes": [],
            "lora_scale": 0.85,
            "width": 512,
            "height": 512,
            "steps": 40,
            "cfg": 4.5,
            "sampler": "default",
            "negative_prompt": "text, watermark, cartoon, illustration, painting, severe image artifacts",
            "seed": 1000,
            "batch_size": 1,
            "prompt_variations": [
                "subtle variation in lighting",
                "slightly different camera exposure",
                "minor background illumination variation",
                "subtle surface appearance variation"
            ],
            "execution": {
                "device": "auto",
                "precision": "auto",
                "memory_strategy": "auto"
            },
            "strength": 0.35
        }
    }
}
